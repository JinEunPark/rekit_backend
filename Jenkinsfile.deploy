pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: '배포할 이미지 태그 (레지스트리에 push된 커밋 short sha, 또는 latest). 롤백 시 이전 sha 입력.'
        )
    }

    environment {
        COMPOSE_PROJECT = 'rekit-backend'
        // 저장소에는 커밋하지 않는 운영용 .env — 호스트의 고정 경로에서 배포 시점에 복사해온다
        PROD_ENV_FILE   = '/home/wlsdms/rekit/secrets/rekit_backend.env'
    }

    stages {
        stage('Deploy') {
            steps {
                echo "Deploying 127.0.0.1:5000/rekit-backend:${params.IMAGE_TAG}"
                sh """
                    cp ${PROD_ENV_FILE} .env
                    IMAGE_TAG=${params.IMAGE_TAG} docker compose -p ${COMPOSE_PROJECT} -f docker-compose.prod.yml pull app
                    IMAGE_TAG=${params.IMAGE_TAG} docker compose -p ${COMPOSE_PROJECT} -f docker-compose.prod.yml up -d postgres redis app
                    docker image prune -f
                """
            }
        }
    }

    post {
        always {
            sh 'rm -f .env'
        }
    }
}
