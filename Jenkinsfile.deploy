pipeline {
    agent any

    parameters {
        // Git Parameter 플러그인 — 배포할 git 태그를 목록에서 고른다.
        gitParameter(
            name: 'VERSION',
            type: 'PT_TAG',
            tagFilter: '*',
            sortMode: 'DESCENDING_SMART',
            selectedValue: 'TOP',
            description: '배포할 git 태그. 그대로 두면 가장 최신 태그. 롤백은 이전 태그를 고른다.'
        )
    }

    environment {
        COMPOSE_PROJECT = 'rekit-backend'
        // 저장소에는 커밋하지 않는 운영용 .env — 호스트의 고정 경로에서 배포 시점에 복사해온다
        PROD_ENV_FILE   = '/home/wlsdms/rekit/secrets/rekit_backend.env'
    }

    stages {
        stage('Deploy') {
            steps {
                script {
                    if (!params.VERSION?.trim()) {
                        error 'VERSION 이 비었습니다. 먼저 build-was 잡으로 해당 태그 이미지를 빌드했는지 확인하세요.'
                    }
                }
                echo "Deploying 127.0.0.1:5000/rekit-backend:${params.VERSION}"
                sh """
                    cp ${PROD_ENV_FILE} .env
                    IMAGE_TAG=${params.VERSION} docker compose -p ${COMPOSE_PROJECT} -f docker-compose.prod.yml pull app
                    IMAGE_TAG=${params.VERSION} docker compose -p ${COMPOSE_PROJECT} -f docker-compose.prod.yml up -d postgres redis app
                    docker image prune -f
                """
            }
        }

        stage('Health check') {
            steps {
                // sh 는 jenkins 컨테이너 안에서 돌아 호스트 loopback(127.0.0.1:8000)이 안 보인다.
                // 앱 컨테이너 내부에서 확인 (백엔드 이미지에 curl 포함됨).
                sh '''
                    for i in $(seq 1 30); do
                        if docker exec rekle-app curl -fsS http://127.0.0.1:8000/health > /dev/null 2>&1; then
                            echo "health OK (${i}회차)"; exit 0
                        fi
                        sleep 2
                    done
                    echo "헬스체크 실패 — rekle-app 로그 확인 후 deploy 잡에서 이전 태그로 롤백하세요."
                    docker logs --tail 50 rekle-app || true
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            sh 'rm -f .env'
        }
    }
}
