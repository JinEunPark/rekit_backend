{
  "uid": "rekle-loadtest",
  "title": "Rekle 부하테스트",
  "description": "k6 remote write 지표와 서버 지표를 같은 시간축으로. k6 run -o experimental-prometheus-rw --tag testid=<이름>",
  "tags": [
    "rekle"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "k6 (부하 생성기 측) — K6_PROMETHEUS_RW_TREND_STATS=p(95),p(99),avg,max 필요",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "가상 사용자 (VU)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(k6_vus{testid=~\"$testid\"})",
          "legendFormat": "VU"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(k6_vus_max{testid=~\"$testid\"})",
          "legendFormat": "VU max"
        }
      ]
    },
