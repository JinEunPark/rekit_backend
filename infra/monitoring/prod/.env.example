# 운영 모니터링 스택 시크릿·설정 — 복사해서 채운다 (값이 비면 compose 가 기동을 거부한다)
#   권장 위치: ~/rekit/secrets/rekle_monitoring.env  → docker compose --env-file 로 지정
#
# Grafana admin 비밀번호 — 최초 기동(DB 생성) 때만 반영된다. 이후 변경은 docs/monitoring.md 참고
GF_SECURITY_ADMIN_PASSWORD=

# 서브경로 서빙 (엣지 nginx 의 location /grafana/ 뒤에 둘 때). SSH 터널로만 쓰면 둘 다 비워 둔다
# GF_SERVER_ROOT_URL=https://rekit.co.kr/grafana/
# GF_SERVER_SERVE_FROM_SUB_PATH=true

# postgres_exporter 전용 읽기 계정 (pg_monitor 롤) — 생성 SQL 은 docs/monitoring.md
PG_MONITOR_USER=rekle_monitor
PG_MONITOR_PASSWORD=

# 앱(rekle-app·rekle-postgres·rekle-redis)이 붙어 있는 네트워크.
# Jenkins deploy 잡이 `docker compose -p rekit-backend` 로 띄우므로 기본 네트워크는 rekit-backend_default.
# 확인: docker inspect rekle-postgres --format '{{json .NetworkSettings.Networks}}'
REKLE_APP_NETWORK=rekit-backend_default
# 엣지 nginx 가 컨테이너명(rekle-mon-grafana)으로 Grafana 에 붙기 위한 공유 네트워크
EDGE_NETWORK=rekit_edge
# SeaweedFS(~/rekit/seaweedfs) 네트워크 — Prometheus 가 seaweedfs:9324 를 긁는다
SEAWEEDFS_NETWORK=seaweedfs_default

# Alertmanager 시크릿 파일 디렉터리 (slack_webhook_url 파일이 들어 있어야 함)
ALERTMANAGER_SECRETS_DIR=./secrets

# 호스트 loopback 포트 — 로컬 스택(9090/3000)과 겹치지 않게 기본값을 다르게 둠
# PROMETHEUS_PORT=9091
# GRAFANA_PORT=3300
# ALERTMANAGER_PORT=9093
