pipeline {
    agent any

    parameters {
        // Git Parameter 플러그인 — git 태그 목록에서 고른다.
        gitParameter(
            name: 'RELEASE_TAG',
            type: 'PT_TAG',
            tagFilter: '*',
            sortMode: 'DESCENDING_SMART',
            selectedValue: 'TOP',
            description: '빌드할 git 태그 (X.Y.Z). `git push origin <tag>` 로 올려둔 태그.'
        )
    }

    environment {
        REGISTRY   = '127.0.0.1:5000'
        IMAGE_NAME = 'rekit-backend'
    }

    stages {
        stage('Checkout tag') {
            steps {
                script {
                    if (!params.RELEASE_TAG?.trim()?.matches(/^\d+\.\d+\.\d+$/)) {
                        error "RELEASE_TAG 형식 오류: '${params.RELEASE_TAG}' (X.Y.Z 여야 함)"
                    }
                    env.IMAGE_TAG = params.RELEASE_TAG.trim()
                }
                // Jenkins SCM 은 master 를 받아오므로, 빌드 대상 태그의 트리로 명시적으로 이동
                sh 'git fetch --tags --force --prune'
                sh "git checkout -f tags/${env.IMAGE_TAG}"
            }
        }

        stage('Build & Push') {
            steps {
                sh """
                    docker build -t ${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG} .
                    docker push ${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG}
                """
            }
        }
    }

    post {
        success {
            echo "이미지 push 완료: ${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG}. 배포는 deploy-was 잡에서 VERSION 드롭다운으로."
        }
    }
}
