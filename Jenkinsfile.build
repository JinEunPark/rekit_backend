pipeline {
    agent any

    parameters {
        // Git Parameter 플러그인 — git 태그 목록에서 고른다.
        gitParameter(
            name: 'RELEASE_TAG',
            type: 'PT_TAG',
            tagFilter: '*',
            sortMode: 'DESCENDING_SMART',
            selectedValue: 'TOP',
            description: '빌드할 git 태그 (X.Y.Z). `git push origin <tag>` 로 올려둔 태그.'
        )
    }

    environment {
        REGISTRY   = '127.0.0.1:5000'
        IMAGE_NAME = 'rekit-backend'
    }

    stages {
        stage('Checkout tag') {
            steps {
                script {
                    if (!params.RELEASE_TAG?.trim()?.matches(/^\d+\.\d+\.\d+$/)) {
                        error "RELEASE_TAG 형식 오류: '${params.RELEASE_TAG}' (X.Y.Z 여야 함)"
                    }
                    env.IMAGE_TAG = params.RELEASE_TAG.trim()
                    env.BUILD_RECIPE = 'Dockerfile'
                    env.GATE_REV = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                }
                // Jenkins SCM 은 master 를 받아오므로, 빌드 대상 태그의 트리로 명시적으로 이동
                sh 'git fetch --tags --force --prune'
                sh "git checkout -f tags/${env.IMAGE_TAG}"
            }
        }

        // 게이트 — ruff · mypy · 단위 테스트 (Dockerfile 의 test 단계). 실패하면 여기서 잡이 멈춰
        // 아래 Build & Push 에 도달하지 않는다 → registry 에 이 태그 이미지가 없으니 deploy-was 도 불가.
        // 검사용 이미지는 registry 에 올리지 않는다.
        stage('Test') {
            steps {
                script {
                    if (env.IMAGE_TAG ==~ /0[.]0[.][1-7]/) {
                        env.GATE_TMP = pwd(tmp: true)
                        env.BUILD_RECIPE = "${env.GATE_TMP}/legacy.Dockerfile"
                        sh '''
                            mkdir -p "$GATE_TMP"
                            git show "$GATE_REV:.dockerignore" > "$BUILD_RECIPE.dockerignore"
                            git show "$GATE_REV:Dockerfile" > "$GATE_TMP/gate.Dockerfile"
                            git show "$GATE_REV:ci/legacy-dockerfile.sh" > "$GATE_TMP/legacy.sh"
                            sh "$GATE_TMP/legacy.sh" "$GATE_TMP/gate.Dockerfile" > "$BUILD_RECIPE"
                        '''
                    }
                }
                sh 'docker build -f "$BUILD_RECIPE" --target test -t "$IMAGE_NAME-test:$IMAGE_TAG" .'
            }
        }

        stage('Build & Push') {
            steps {
                sh """
                    docker build -f "${env.BUILD_RECIPE}" --target runtime -t ${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG} .
                    docker push ${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG}
                """
            }
        }
    }

    post {
        always {
            // 검사용 이미지는 남길 이유가 없다 — 디스크만 차지
            sh "docker image rm ${IMAGE_NAME}-test:${env.IMAGE_TAG} || true"
        }
        success {
            echo "이미지 push 완료: ${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG}. 배포는 deploy-was 잡에서 VERSION 드롭다운으로."
        }
    }
}
