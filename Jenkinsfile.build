pipeline {
    agent any

    parameters {
        string(
            name: 'RELEASE_TAG',
            defaultValue: '',
            description: '빌드할 git 태그 (X.Y.Z). 먼저 `git push origin <tag>` 로 올려둔 태그여야 한다.'
        )
    }

    environment {
        REGISTRY   = '127.0.0.1:5000'
        IMAGE_NAME = 'rekit-backend'
    }

    stages {
        stage('Checkout tag') {
            steps {
                script {
                    if (!params.RELEASE_TAG?.trim()) {
                        error 'RELEASE_TAG 를 입력하세요 (예: 0.0.1)'
                    }
                }
                sh 'git fetch --tags --force --prune'
                sh "git checkout tags/${params.RELEASE_TAG}"
                script {
                    // 이미지 태그 = 지금 체크아웃된 커밋에 정확히 달린 git 태그 (없으면 실패)
                    env.IMAGE_TAG = sh(
                        script: 'git describe --tags --exact-match HEAD',
                        returnStdout: true
                    ).trim()
                    if (!env.IMAGE_TAG?.matches(/^\d+\.\d+\.\d+$/)) {
                        error "HEAD 에 X.Y.Z 형식 태그가 없습니다: '${env.IMAGE_TAG}'"
                    }
                }
            }
        }

        stage('Build & Push') {
            steps {
                sh """
                    docker build -t ${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG} .
                    docker push ${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG}
                """
            }
        }
    }

    post {
        success {
            echo "이미지 push 완료: ${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG}. 배포는 rekit-backend-deploy 잡에서 VERSION 드롭다운으로 실행."
        }
    }
}
