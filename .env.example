# Application
APP_NAME="Rekle Backend"
APP_ENV=development
DEBUG=true
# JWT 서명 키 — `python -c "import secrets; print(secrets.token_urlsafe(64))"` 등으로 생성
JWT_SECRET=change-me-with-secrets.token_urlsafe-64

# API
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://rekle:rekle@localhost:5432/rekle

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# 로그인 시 remember=true 면 적용되는 만료 (기본 14일 대신 30일)
REFRESH_TOKEN_REMEMBER_DAYS=30

# CORS (JSON 배열 형식)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Redis
REDIS_URL=redis://localhost:6379/0

# ── 이메일 발송 ────────────────────────────────────────
# provider: console (dev — stdout 출력) / gmail (Gmail SMTP)
EMAIL_PROVIDER=console
# Gmail SMTP 사용 시 (provider=gmail) — App Password 필요:
#   1) myaccount.google.com → 보안 → 2단계 인증 ON
#   2) myaccount.google.com/apppasswords → 16자리 발급
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 발신자 표시. 미지정 시 GMAIL_USER 그대로
EMAIL_FROM="Rekit <noreply@rekit.kr>"
# 비밀번호 재설정/링크 메일 본문에 박을 프론트 base URL
FRONTEND_URL=http://localhost:5173

# ── 소셜 로그인 OAuth ──────────────────────────────────
# 카카오: developers.kakao.com → 내 애플리케이션 → REST API 키 + Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/callback/kakao
# 네이버: developers.naver.com → 애플리케이션 → Client ID + Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:5173/auth/callback/naver
# 구글: console.cloud.google.com → APIs & Services → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google
# 소셜 신규가입용 임시 토큰 만료 (분)
SOCIAL_SIGNUP_TOKEN_EXPIRE_MINUTES=15

# Toss Payments — 시크릿 키(주문서형·결제창형 연동 = gsk). 개발자센터에서 발급. **필수**.
# 테스트: test_gsk_*, 운영: live_gsk_*. clientKey(gck)는 프론트 전용이라 여기 없음.
# 웹훅: 개발자센터 → 웹훅에 https://{도메인}/api/v1/payments/webhooks/toss 등록(PAYMENT_STATUS_CHANGED).
TOSS_SECRET_KEY=test_gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# 휴대폰 인증 (Octomo — 마이페이지에서 API 키 발급: https://octomo.octoverse.kr)
OCTOMO_API_KEY=

# Object Storage (S3 호환 — dev: SeaweedFS, prod: AWS S3 등으로 교체)
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=ap-northeast-2
S3_BUCKET=rekle-images
S3_ACCESS_KEY=rekle-dev-access
S3_SECRET_KEY=rekle-dev-secret
# 공개 이미지 URL prefix (CDN 붙이면 그 도메인으로 교체)
S3_PUBLIC_URL_BASE=http://localhost:8333/rekle-images
# SeaweedFS는 path-style 필수 (AWS는 virtual-hosted 가능)
S3_FORCE_PATH_STYLE=true

# 배송 추적 (스마트택배)
SWEET_TRACKER_API_KEY=

# 모니터링
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
